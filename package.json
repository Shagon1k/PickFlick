{
    "name": "pickflick",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.25.0",
    "engines": {
        "node": "24.15.0",
        "pnpm": "11.25.0"
    },
    "scripts": {
        "dev": "pnpm build:packages && pnpm --parallel --stream --filter @pickflick/contracts --filter @pickflick/frontend --filter @pickflick/backend dev",
        "start": "pnpm run --parallel \"/^start:(app|worker)$/\"",
        "build": "pnpm -r --if-present build",
        "build:packages": "pnpm -r --filter './packages/*' --if-present build",
        "build:images": "node scripts/build-images.mjs",
        "lint": "eslint . --max-warnings 0 && stylelint \"apps/frontend/src/**/*.scss\"",
        "lint:fix": "eslint . --fix && stylelint \"apps/frontend/src/**/*.scss\" --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.json",
        "knip": "knip",
        "verify": "pnpm security:audit && pnpm lint && pnpm knip && pnpm format:check && pnpm typecheck && pnpm test:unit && pnpm build",
        "test:unit": "vitest run",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "test:ui": "playwright test --config playwright.ui.config.ts",
        "test:ui:smoke": "playwright test --config playwright.ui.config.ts --grep @smoke --grep-invert @visual",
        "test:ui:contract": "playwright test --config playwright.ui.config.ts --grep-invert @visual",
        "test:ui:visual": "playwright test --config playwright.ui.config.ts --grep @visual",
        "test:ui:update": "pnpm test:ui:visual --update-snapshots",
        "test:e2e": "node scripts/e2e-smoke.mjs",
        "test:journeys": "playwright test --config playwright.journeys.config.ts",
        "test:uat": "playwright test --config playwright.uat.config.ts",
        "db:migrate": "pnpm --filter @pickflick/database migrate",
        "db:seed": "pnpm --filter @pickflick/database seed",
        "db:reset": "pnpm --filter @pickflick/database reset",
        "services:up": "docker compose --env-file .env -f compose.local.yaml up -d --wait postgres redis minio && docker compose --env-file .env -f compose.local.yaml run --rm minio-init",
        "services:down": "docker compose --env-file .env -f compose.local.yaml down",
        "services:check": "pnpm --filter @pickflick/database services:check",
        "deploy:uat": "node scripts/deploy-compose.mjs",
        "deploy:check": "sh scripts/check-compose.sh",
        "prepare": "husky",
        "postinstall": "pnpm --filter @pickflick/config build && pnpm --filter @pickflick/database generate",
        "security:audit": "pnpm audit --prod --audit-level high",
        "start:app": "pnpm --parallel --stream --filter @pickflick/frontend --filter @pickflick/backend start",
        "start:worker": "pnpm --filter @pickflick/backend start:worker",
        "test:worker": "node scripts/deadline-worker-smoke.mjs"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.13.0",
        "@commitlint/cli": "21.0.1",
        "@commitlint/config-conventional": "21.0.1",
        "@commitlint/types": "21.2.3",
        "@pickflick/contracts": "workspace:*",
        "@pickflick/eslint-config": "workspace:*",
        "@playwright/test": "1.63.0",
        "@types/node": "catalog:",
        "eslint": "10.10.0",
        "husky": "9.1.7",
        "knip": "6.38.0",
        "prettier": "3.8.3",
        "stylelint": "17.15.0",
        "stylelint-config-recess-order": "7.8.0",
        "stylelint-config-standard-scss": "17.0.0",
        "stylelint-order": "8.1.1",
        "typescript": "catalog:",
        "vite": "8.2.4",
        "vitest": "5.0.0"
    }
}
