{
    "name": "pickflick",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.25.0",
    "engines": {
        "node": "24.15.0",
        "pnpm": "11.25.0"
    },
    "scripts": {
        "auth:check": "pnpm --filter @pickflick/api auth:check",
        "build": "pnpm check:workspace && pnpm -r --if-present build",
        "check:workspace": "node scripts/check-workspace.mjs",
        "club:check": "pnpm build:packages && pnpm --filter @pickflick/api club:check",
        "db:check": "pnpm --filter @pickflick/database check",
        "db:reset": "pnpm --filter @pickflick/database reset",
        "deploy:compose": "node scripts/deploy-compose.mjs",
        "dev": "pnpm build:packages && pnpm --parallel --stream --filter @pickflick/contracts --filter @pickflick/ui --filter @pickflick/web --filter @pickflick/api --filter @pickflick/worker dev",
        "e2e:smoke": "node scripts/e2e-smoke.mjs",
        "compose:check": "node scripts/check-deployment.mjs",
        "contact:check": "pnpm --filter @pickflick/api contact:check",
        "images:build": "node scripts/build-images.mjs",
        "build:packages": "pnpm -r --filter './packages/*' --if-present build",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "migrate": "pnpm --filter @pickflick/database migrate",
        "production:promote": "node scripts/promote-production.mjs",
        "release": "node scripts/run-release.mjs",
        "prepare": "husky",
        "postinstall": "pnpm --filter @pickflick/config build && pnpm --filter @pickflick/database generate",
        "seed": "pnpm --filter @pickflick/database seed",
        "services:check": "pnpm --filter @pickflick/observability build && pnpm --filter @pickflick/database services:check",
        "services:down": "docker compose --env-file .env -f compose.local.yaml down",
        "services:up": "docker compose --env-file .env -f compose.local.yaml up -d --wait postgres redis minio && docker compose --env-file .env -f compose.local.yaml run --rm minio-init",
        "start": "pnpm --parallel --stream --filter @pickflick/web --filter @pickflick/api --filter @pickflick/worker start",
        "test": "vitest run",
        "typecheck": "pnpm -r --if-present typecheck",
        "ui:test": "playwright test --config playwright.ui.config.ts",
        "ui:test:update": "playwright test --config playwright.ui.config.ts --update-snapshots",
        "ui:smoke": "node scripts/ui-preview-smoke.mjs",
        "ui:visual": "playwright test --config playwright.ui.config.ts tests/ui-preview/viewport-visual.spec.ts",
        "uat:deploy": "node scripts/deploy-uat.mjs",
        "uat:smoke": "node scripts/uat-browser-smoke.mjs",
        "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.13.0",
        "@commitlint/cli": "21.0.1",
        "@commitlint/config-conventional": "21.0.1",
        "@pickflick/config": "workspace:*",
        "@playwright/test": "1.63.0",
        "@types/node": "catalog:",
        "eslint": "10.10.0",
        "husky": "9.1.7",
        "prettier": "3.8.3",
        "vite": "8.2.2",
        "vitest": "5.0.0"
    }
}
