{
    "name": "pickflick",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.25.0",
    "engines": {
        "node": "24.15.0",
        "pnpm": "11.25.0"
    },
    "scripts": {
        "build": "pnpm -r --if-present build",
        "db:reset": "pnpm --filter @pickflick/database reset",
        "deploy:compose": "node scripts/deploy-compose.mjs",
        "dev": "pnpm build:packages && pnpm --parallel --stream --filter @pickflick/contracts --filter @pickflick/frontend --filter @pickflick/backend dev",
        "e2e:smoke": "node scripts/e2e-smoke.mjs",
        "compose:check": "sh scripts/check-compose.sh",
        "images:build": "node scripts/build-images.mjs",
        "knip": "knip",
        "build:packages": "pnpm -r --filter './packages/*' --if-present build",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint . && stylelint \"apps/frontend/src/**/*.scss\"",
        "lint:fix": "eslint . --fix && stylelint \"apps/frontend/src/**/*.scss\" --fix",
        "migrate": "pnpm --filter @pickflick/database migrate",
        "release": "node scripts/run-release.mjs",
        "prepare": "husky",
        "postinstall": "pnpm --filter @pickflick/config build && pnpm --filter @pickflick/database generate",
        "seed": "pnpm --filter @pickflick/database seed",
        "services:check": "pnpm --filter @pickflick/database services:check",
        "services:down": "docker compose --env-file .env -f compose.local.yaml down",
        "services:up": "docker compose --env-file .env -f compose.local.yaml up -d --wait postgres minio && docker compose --env-file .env -f compose.local.yaml run --rm minio-init",
        "start": "pnpm --parallel --stream --filter @pickflick/frontend --filter @pickflick/backend start",
        "test": "vitest run",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "typecheck": "pnpm -r --if-present typecheck",
        "ui:test": "playwright test --config playwright.ui.config.ts",
        "ui:test:update": "playwright test --config playwright.ui.config.ts --update-snapshots",
        "ui:visual": "playwright test --config playwright.ui.config.ts tests/ui-preview/viewport-visual.spec.ts",
        "uat:smoke": "playwright test --config playwright.uat.config.ts",
        "verify": "pnpm lint && pnpm knip && pnpm format:check && pnpm typecheck && pnpm test && pnpm build"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.13.0",
        "@commitlint/cli": "21.0.1",
        "@commitlint/config-conventional": "21.0.1",
        "@commitlint/types": "21.2.3",
        "@pickflick/config": "workspace:*",
        "@playwright/test": "1.63.0",
        "@types/node": "catalog:",
        "eslint": "10.10.0",
        "husky": "9.1.7",
        "knip": "6.38.0",
        "prettier": "3.8.3",
        "stylelint": "17.15.0",
        "stylelint-config-standard-scss": "17.0.0",
        "vite": "8.2.2",
        "vitest": "5.0.0"
    }
}
