# Safe synthetic defaults for compose.local.yaml. Copy this file to .env for local development.
APP_ENV=local
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3001

POSTGRES_DB=pickflick_local
POSTGRES_USER=pickflick
POSTGRES_PASSWORD=local-only-postgres-password
POSTGRES_PORT=15432
DATABASE_URL=postgresql://pickflick:local-only-postgres-password@127.0.0.1:15432/pickflick_local

REDIS_URL=redis://127.0.0.1:16379
REDIS_PORT=16379

MINIO_ROOT_USER=pickflick-local
MINIO_ROOT_PASSWORD=local-only-minio-password
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
STORAGE_ENDPOINT=http://127.0.0.1:19000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=pickflick-local
STORAGE_ACCESS_KEY=pickflick-local
STORAGE_SECRET_KEY=local-only-minio-password
STORAGE_FORCE_PATH_STYLE=true

# Configure the provider signing secret in UAT/production before enabling notification email.
RESEND_WEBHOOK_SECRET=
RESEND_DELIVERY_MODE=disabled
RESEND_API_KEY=local-disabled
RESEND_FROM="PickFlick <pickflick@example.invalid>"
CONTACT_DELIVERY_TO=contact@example.invalid

# Google is active locally. Apple stays dormant unless its gate and all four provider values are supplied.
AUTH_BASE_URL=http://127.0.0.1:3000
AUTH_SECRET=local-only-auth-secret-change-before-shared-use
APPLE_SIGN_IN_ENABLED=false
GOOGLE_CLIENT_ID=local-synthetic-google-client-id
GOOGLE_CLIENT_SECRET=local-synthetic-google-client-secret

CATALOG_PROVIDER=poiskkino-thetvdb
CATALOG_LOCALE=en-US
CATALOG_ENABLED=false
CATALOG_TIMEOUT_MS=5000
POISKKINO_API_KEY=
THETVDB_READ_TOKEN=
# TMDB credentials are required only when the TMDB catalog is selected and enabled.
TMDB_READ_TOKEN=
CATALOG_REFRESH_HOURS=24
CATALOG_STALE_HOURS=168
