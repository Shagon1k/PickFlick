# Safe synthetic defaults for compose.local.yaml. Copy this file to .env for local development.
APP_ENV=local
API_HOST=127.0.0.1
API_PORT=3001
SHUTDOWN_TIMEOUT_MS=10000

POSTGRES_DB=pickflick_local
POSTGRES_USER=pickflick
POSTGRES_PASSWORD=local-only-postgres-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pickflick:local-only-postgres-password@127.0.0.1:5432/pickflick_local

REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

MINIO_ROOT_USER=pickflick-local
MINIO_ROOT_PASSWORD=local-only-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=pickflick-local
S3_ACCESS_KEY_ID=pickflick-local
S3_SECRET_ACCESS_KEY=local-only-minio-password
S3_FORCE_PATH_STYLE=true

MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="PickFlick <pickflick@example.invalid>"
