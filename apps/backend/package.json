{
    "name": "@pickflick/backend",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsc -p tsconfig.build.json && pnpm run --parallel \"/^dev:(api|worker)$/\"",
        "start": "node dist/main.js",
        "typecheck": "tsc -p tsconfig.json",
        "dev:api": "nodemon",
        "dev:worker": "nodemon --config nodemon-worker.json",
        "start:worker": "node dist/deadline-worker.js"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.1140.0",
        "@better-auth/prisma-adapter": "1.7.7",
        "@nestjs/common": "12.1.0",
        "@nestjs/core": "12.1.0",
        "@nestjs/platform-express": "12.1.0",
        "@nestjs/throttler": "6.7.1",
        "@pickflick/config": "workspace:*",
        "@pickflick/contracts": "workspace:*",
        "@pickflick/database": "workspace:*",
        "better-auth": "catalog:",
        "nestjs-pino": "5.2.1",
        "pino": "10.3.1",
        "pino-http": "11.0.0",
        "redis": "6.3.0",
        "reflect-metadata": "0.2.2",
        "resend": "6.29.0",
        "rxjs": "7.8.2",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@nestjs/testing": "12.1.0",
        "@types/express": "^5.0.6",
        "@types/node": "catalog:",
        "nodemon": "3.1.14",
        "typescript": "catalog:"
    }
}
