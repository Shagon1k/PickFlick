{
    "extends": "@pickflick/config/tsconfig/nextjs.json",
    "compilerOptions": {
        "types": ["node", "vitest/globals", "next/image-types/global"],
        "paths": {
            "@/*": ["./src/*"],
            "@brand/*": ["../../assets/brand/*"]
        }
    },
    "include": [
        "next-env.d.ts",
        "next.config.ts",
        "src/**/*.ts",
        "src/**/*.tsx",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts"
    ],
    "exclude": ["node_modules"]
}
