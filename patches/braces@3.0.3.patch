diff --git a/lib/validate-depth.js b/lib/validate-depth.js
new file mode 100644
--- /dev/null
+++ b/lib/validate-depth.js
@@ -0,0 +1,27 @@
+'use strict';
+
+// Caller-supplied ASTs bypass parse. Walk only child edges, never parent/prev links.
+module.exports = ast => {
+  const active = new Set();
+  let visits = 0;
+  const stack = [{ node: ast, depth: ast && ast.type === 'root' ? 0 : 1, exit: false }];
+  while (stack.length) {
+    const { node, depth, exit } = stack.pop();
+    if (!exit && ++visits > 200000) throw new SyntaxError('Input AST exceeds maximum work (200000)');
+    if (!node || !Array.isArray(node.nodes)) continue;
+    if (exit) {
+      active.delete(node);
+      continue;
+    }
+    if (active.has(node)) throw new SyntaxError('Cyclic braces AST');
+    if (depth > 100) {
+      throw new SyntaxError('Input nesting exceeds maximum depth (100)');
+    }
+    if (visits + stack.length + node.nodes.length + 1 > 200000) throw new SyntaxError('Input AST exceeds maximum work (200000)');
+    active.add(node);
+    stack.push({ node, depth, exit: true });
+    for (let i = node.nodes.length - 1; i >= 0; i--) {
+      stack.push({ node: node.nodes[i], depth: depth + 1, exit: false });
+    }
+  }
+};
