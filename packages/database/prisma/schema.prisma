generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum AppRole {
  USER
  APP_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  ANONYMIZED
}

enum ClubLifecycle {
  ACTIVE
  ARCHIVED
}

enum ClubRole {
  ADMIN
  MODERATOR
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  LEFT
  REMOVED
}

enum ClubAuditAction {
  MEMBERSHIP_ROLE_CHANGED
  ADMIN_TRANSFERRED
  CLUB_SETTINGS_UPDATED
  CLUB_AVATAR_UPDATED
  CLUB_ARCHIVED
  CLUB_REACTIVATED
  MEMBERSHIP_LEFT
  CLUB_DELETED
}

enum SessionType {
  FULL_CYCLE
  PRE_SELECTED
  PAST
}

enum SessionPhase {
  NOMINATION
  SELECTION
  WATCHING
  RATING
  COMPLETED
  CANCELLED
}

model User {
  id                       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                    String            @unique
  emailVerified            Boolean           @default(false)
  displayName              String
  image                    String?
  appRole                  AppRole           @default(USER)
  status                   UserStatus        @default(ACTIVE)
  locale                   String            @default("en")
  createdAt                DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime          @updatedAt @db.Timestamptz(3)
  memberships              Membership[]
  authSessions             AuthSession[]
  providerAccounts         ProviderAccount[]
  clubAuditEventsAsActor   ClubAuditEvent[]  @relation("ClubAuditActor")
  clubAuditEventsAsSubject ClubAuditEvent[]  @relation("ClubAuditSubject")
}

model AuthSession {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ProviderAccount {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerSubject       String
  provider              String
  userId                String    @db.Uuid
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
}

model AuthVerification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String   @db.Text
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

model AuthRateLimit {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Club {
  id                          String           @id @db.Uuid
  name                        String
  description                 String?
  avatarObjectKey             String?
  lifecycle                   ClubLifecycle    @default(ACTIVE)
  selectionScaleMin           Int              @default(1)
  selectionScaleMax           Int              @default(5)
  showNominationAuthors       Boolean          @default(true)
  showNominationsBeforeSubmit Boolean          @default(true)
  showVoteResults             Boolean          @default(false)
  showRatingResults           Boolean          @default(true)
  useMonochromeMedia          Boolean          @default(true)
  deletedAt                   DateTime?        @db.Timestamptz(3)
  createdAt                   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime         @updatedAt @db.Timestamptz(3)
  memberships                 Membership[]
  sessions                    Session[]
  auditEvents                 ClubAuditEvent[]
}

model Membership {
  id          String           @id @db.Uuid
  clubId      String           @db.Uuid
  userId      String           @db.Uuid
  role        ClubRole         @default(MEMBER)
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now()) @db.Timestamptz(3)
  leftAt      DateTime?        @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  club        Club             @relation(fields: [clubId], references: [id], onDelete: Restrict)
  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  auditEvents ClubAuditEvent[]

  // PostgreSQL migration owns the partial unique index for one ACTIVE row per User/Club.
  @@index([clubId, userId])
  @@index([userId, status])
}

model ClubAuditEvent {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clubId              String          @db.Uuid
  actorUserId         String          @db.Uuid
  subjectUserId       String          @db.Uuid
  subjectMembershipId String          @db.Uuid
  action              ClubAuditAction
  changed             Boolean
  previousRole        ClubRole?
  nextRole            ClubRole?
  previousLifecycle   ClubLifecycle?
  nextLifecycle       ClubLifecycle?
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  club                Club            @relation(fields: [clubId], references: [id], onDelete: Restrict)
  actor               User            @relation("ClubAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  subject             User            @relation("ClubAuditSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  subjectMembership   Membership      @relation(fields: [subjectMembershipId], references: [id], onDelete: Restrict)

  @@index([clubId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([subjectUserId, createdAt])
  @@index([subjectMembershipId, createdAt])
}

model Session {
  id           String       @id @db.Uuid
  clubId       String       @db.Uuid
  type         SessionType
  phase        SessionPhase
  scheduledAt  DateTime?    @db.Timestamptz(3)
  location     String?
  topic        String?
  notes        String?
  deadlineAt   DateTime?    @db.Timestamptz(3)
  phaseVersion Int          @default(1)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)
  club         Club         @relation(fields: [clubId], references: [id], onDelete: Restrict)

  @@index([clubId, phase])
}
