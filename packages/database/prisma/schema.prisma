generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum AppRole {
  USER
  APP_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  ANONYMIZED
}

enum ClubLifecycle {
  ACTIVE
  ARCHIVED
}

enum ClubRole {
  ADMIN
  MODERATOR
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  LEFT
  REMOVED
}

enum ClubAuditAction {
  SESSION_RATING_CLOSED
  SESSION_RATING_OPENED
  SESSION_SELECTION_CLOSED
  SESSION_NOMINATION_CLOSED
  SESSION_INVITE_CREATED
  SESSION_INVITE_REVOKED
  SESSION_INVITE_RESPONDED
  SESSION_PARTICIPANT_LEFT
  SESSION_PARTICIPANT_REMOVED
  SESSION_CREATED
  SESSION_UPDATED
  SESSION_CANCELLED
  MEMBERSHIP_ROLE_CHANGED
  ADMIN_TRANSFERRED
  CLUB_SETTINGS_UPDATED
  CLUB_AVATAR_UPDATED
  CLUB_ARCHIVED
  CLUB_REACTIVATED
  MEMBERSHIP_REMOVED
  MEMBERSHIP_LEFT
  CLUB_DELETED
  CLUB_INVITE_CREATED
  CLUB_INVITE_REVOKED
  MEMBERSHIP_JOINED
}

enum SessionType {
  FULL_CYCLE
  PRE_SELECTED
  PAST
}

enum SessionPhase {
  NOMINATION
  SELECTION
  WATCHING
  RATING
  COMPLETED
  CANCELLED
}

enum SessionParticipantStatus {
  INVITED
  ACCEPTED
  DECLINED
  LEFT
  REMOVED
}

model User {
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]
  id                       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                    String                   @unique
  emailVerified            Boolean                  @default(false)
  displayName              String
  image                    String?
  appRole                  AppRole                  @default(USER)
  status                   UserStatus               @default(ACTIVE)
  locale                   String                   @default("en")
  createdAt                DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                 @updatedAt @db.Timestamptz(3)
  createdClubInvites       ClubInvite[]             @relation("ClubInviteCreator")
  targetedClubInvites      ClubInvite[]             @relation("ClubInviteTarget")
  answeredClubInvites      ClubInvite[]             @relation("ClubInviteResponder")
  personalRatings          PersonalMovieRating[]
  watchlistItems           WatchlistItem[]
  memberships              Membership[]
  achievements             AchievementAward[]
  authSessions             AuthSession[]
  providerAccounts         ProviderAccount[]
  clubAuditEventsAsActor   ClubAuditEvent[]         @relation("ClubAuditActor")
  clubAuditEventsAsSubject ClubAuditEvent[]         @relation("ClubAuditSubject")
}

model AuthSession {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ProviderAccount {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerSubject       String
  provider              String
  userId                String    @db.Uuid
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
}

model AuthVerification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String   @db.Text
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

model AuthRateLimit {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Club {
  achievements                AchievementAward[]
  id                          String             @id @db.Uuid
  name                        String
  description                 String?
  avatarObjectKey             String?
  lifecycle                   ClubLifecycle      @default(ACTIVE)
  selectionScaleMin           Int                @default(0)
  selectionScaleMax           Int                @default(5)
  showNominationAuthors       Boolean            @default(true)
  showNominationsBeforeSubmit Boolean            @default(true)
  showVoteResults             Boolean            @default(false)
  showRatingResults           Boolean            @default(true)
  useMonochromeMedia          Boolean            @default(true)
  deletedAt                   DateTime?          @db.Timestamptz(3)
  createdAt                   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime           @updatedAt @db.Timestamptz(3)
  memberships                 Membership[]
  sessions                    Session[]
  auditEvents                 ClubAuditEvent[]
  invitations                 ClubInvite[]
}

model AchievementAward {
  private     Boolean  @default(false)
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String
  version     Int
  title       String
  description String
  target      Int
  userId      String?  @db.Uuid
  clubId      String?  @db.Uuid
  progress    Int
  explanation String
  evidence    Json
  awardedAt   DateTime @default(now()) @db.Timestamptz(3)
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  club        Club?    @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([key, version, userId])
  @@unique([key, version, clubId])
  @@index([userId])
  @@index([clubId])
}

model Membership {
  id                    String               @id @db.Uuid
  clubId                String               @db.Uuid
  userId                String               @db.Uuid
  role                  ClubRole             @default(MEMBER)
  status                MembershipStatus     @default(ACTIVE)
  joinedAt              DateTime             @default(now()) @db.Timestamptz(3)
  leftAt                DateTime?            @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @db.Timestamptz(3)
  club                  Club                 @relation(fields: [clubId], references: [id], onDelete: Restrict)
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  auditEvents           ClubAuditEvent[]
  sessionParticipants   SessionParticipant[]
  pastNominations       PastNomination[]
  createdSessionInvites SessionInvite[]      @relation("SessionInviteCreator")

  @@unique([id, clubId])
  // PostgreSQL migration owns the partial unique index for one ACTIVE row per User/Club.
  @@index([clubId, userId])
  @@index([userId, status])
}

model ClubAuditEvent {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clubId              String          @db.Uuid
  actorUserId         String          @db.Uuid
  subjectUserId       String          @db.Uuid
  subjectMembershipId String          @db.Uuid
  action              ClubAuditAction
  changed             Boolean
  previousRole        ClubRole?
  nextRole            ClubRole?
  previousLifecycle   ClubLifecycle?
  nextLifecycle       ClubLifecycle?
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  sessionId           String?         @db.Uuid
  session             Session?        @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  club                Club            @relation(fields: [clubId], references: [id], onDelete: Restrict)
  actor               User            @relation("ClubAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  subject             User            @relation("ClubAuditSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  subjectMembership   Membership      @relation(fields: [subjectMembershipId], references: [id], onDelete: Restrict)

  @@index([clubId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([subjectUserId, createdAt])
  @@index([subjectMembershipId, createdAt])
}

model Session {
  id                          String                       @id @db.Uuid
  clubId                      String                       @db.Uuid
  type                        SessionType
  phase                       SessionPhase
  scheduledAt                 DateTime?                    @db.Timestamptz(3)
  location                    String?
  topic                       String?
  notes                       String?
  movieId                     String?                      @db.Uuid
  movie                       Movie?                       @relation(fields: [movieId], references: [id], onDelete: Restrict)
  detailsVersion              Int                          @default(1)
  auditEvents                 ClubAuditEvent[]
  deadlineVersion             Int                          @default(1)
  deadlineDecisions           NominationDeadlineDecision[]
  deadlineAt                  DateTime?                    @db.Timestamptz(3)
  phaseVersion                Int                          @default(1)
  progressVersion             Int                          @default(1)
  progressEvents              SessionProgressEvent[]
  selectionScaleMin           Int
  selectionScaleMax           Int
  selectionResult             Json?
  showNominationAuthors       Boolean
  showNominationsBeforeSubmit Boolean
  showVoteResults             Boolean
  showRatingResults           Boolean
  useMonochromeMedia          Boolean
  createdAt                   DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime                     @updatedAt @db.Timestamptz(3)
  club                        Club                         @relation(fields: [clubId], references: [id], onDelete: Restrict)
  participants                SessionParticipant[]
  nominations                 Nomination[]
  selectionBallots            SelectionBallot[]
  ratings                     SessionRating[]
  pastNominations             PastNomination[]

  // PostgreSQL migration owns the partial unique index for one blocking Session per Club.
  @@unique([id, clubId])
  @@index([clubId, phase])
  @@index([phase, deadlineAt])
}

model SessionParticipant {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId           String                   @db.Uuid
  membershipId        String                   @db.Uuid
  clubId              String                   @db.Uuid
  status              SessionParticipantStatus @default(INVITED)
  attended            Boolean?
  createdAt           DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @db.Timestamptz(3)
  session             Session                  @relation(fields: [sessionId, clubId], references: [id, clubId], onDelete: Restrict)
  membership          Membership               @relation(fields: [membershipId, clubId], references: [id, clubId], onDelete: Restrict)
  invitations         SessionInvite[]
  nomination          Nomination?
  selectionBallot     SelectionBallot?
  rating              SessionRating?
  pastSelectionScores PastSelectionScore[]

  @@unique([sessionId, membershipId])
  @@unique([id, sessionId])
  @@unique([id, clubId])
  @@index([membershipId])
}

model SessionInvite {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenDigest         String             @unique @db.Char(64)
  participantId       String             @db.Uuid
  clubId              String             @db.Uuid
  inviterMembershipId String             @db.Uuid
  expiresAt           DateTime           @db.Timestamptz(3)
  revokedAt           DateTime?          @db.Timestamptz(3)
  respondedAt         DateTime?          @db.Timestamptz(3)
  accepted            Boolean?
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  participant         SessionParticipant @relation(fields: [participantId, clubId], references: [id, clubId], onDelete: Restrict)
  inviter             Membership         @relation("SessionInviteCreator", fields: [inviterMembershipId, clubId], references: [id, clubId], onDelete: Restrict)

  @@index([participantId, createdAt])
  @@index([inviterMembershipId])
}

model ClubInvite {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenDigest  String    @unique @db.Char(64)
  clubId       String    @db.Uuid
  inviterId    String    @db.Uuid
  targetUserId String?   @db.Uuid
  responderId  String?   @db.Uuid
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  respondedAt  DateTime? @db.Timestamptz(3)
  accepted     Boolean?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  club         Club      @relation(fields: [clubId], references: [id], onDelete: Restrict)
  inviter      User      @relation("ClubInviteCreator", fields: [inviterId], references: [id], onDelete: Restrict)
  target       User?     @relation("ClubInviteTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  responder    User?     @relation("ClubInviteResponder", fields: [responderId], references: [id], onDelete: Restrict)

  @@index([clubId, createdAt])
}

model Movie {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  title           String?
  releaseYear     Int?
  externalIds     MovieExternalId[]
  details         MovieDetailsCache[]
  sessions        Session[]
  nominations     Nomination[]
  pastNominations PastNomination[]
  personalRatings PersonalMovieRating[]
  watchlistItems  WatchlistItem[]
}

model MovieExternalId {
  movieId    String @db.Uuid
  source     String @db.VarChar(20)
  externalId String @db.VarChar(32)
  movie      Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([source, externalId])
  @@unique([movieId, source])
}

model MovieDetailsCache {
  movieId   String   @db.Uuid
  key       String   @db.Char(64)
  data      Json
  fetchedAt DateTime @db.Timestamptz(3)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([movieId, key])
}

model MovieSearchCache {
  key       String   @id @db.Char(64)
  data      Json
  fetchedAt DateTime @db.Timestamptz(3)
}

model Nomination {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId       String             @db.Uuid
  participantId   String             @db.Uuid
  movieId         String             @db.Uuid
  submittedAt     DateTime           @default(now()) @db.Timestamptz(3)
  session         Session            @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  participant     SessionParticipant @relation(fields: [participantId, sessionId], references: [id, sessionId], onDelete: Restrict)
  movie           Movie              @relation(fields: [movieId], references: [id], onDelete: Restrict)
  isInSelection   Boolean            @default(false)
  selectionScores SelectionScore[]

  @@unique([id, sessionId])
  @@unique([participantId, sessionId])
  @@index([sessionId, submittedAt])
}

// Imported evidence may have a known nominator, but no ballot completeness or original time.
model PastNomination {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId             String               @db.Uuid
  movieId               String               @db.Uuid
  nominatorMembershipId String?              @db.Uuid
  session               Session              @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  movie                 Movie                @relation(fields: [movieId], references: [id], onDelete: Restrict)
  nominator             Membership?          @relation(fields: [nominatorMembershipId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  scores                PastSelectionScore[]

  @@unique([sessionId, movieId])
  @@unique([id, sessionId])
}

model PastSelectionScore {
  nominationId  String             @db.Uuid
  participantId String             @db.Uuid
  sessionId     String             @db.Uuid
  score         Int
  nomination    PastNomination     @relation(fields: [nominationId, sessionId], references: [id, sessionId], onDelete: Restrict)
  participant   SessionParticipant @relation(fields: [participantId, sessionId], references: [id, sessionId], onDelete: Restrict)

  @@id([nominationId, participantId])
  @@index([participantId])
}

model SelectionBallot {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId     String             @db.Uuid
  participantId String             @db.Uuid
  submittedAt   DateTime           @default(now()) @db.Timestamptz(3)
  session       Session            @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  participant   SessionParticipant @relation(fields: [participantId, sessionId], references: [id, sessionId], onDelete: Restrict)
  scores        SelectionScore[]

  @@unique([participantId, sessionId])
  @@unique([id, sessionId])
  @@index([sessionId])
}

model SelectionScore {
  ballotId     String          @db.Uuid
  nominationId String          @db.Uuid
  sessionId    String          @db.Uuid
  score        Int
  ballot       SelectionBallot @relation(fields: [ballotId, sessionId], references: [id, sessionId], onDelete: Restrict)
  nomination   Nomination      @relation(fields: [nominationId, sessionId], references: [id, sessionId], onDelete: Restrict)

  @@id([ballotId, nominationId])
}

enum NominationDeadlineOutcome {
  EMPTY
  WATCHING
  SELECTION
}

// Automatic decisions have no human actor; this is their immutable audit record.
model NominationDeadlineDecision {
  sessionId       String                    @db.Uuid
  deadlineVersion Int
  outcome         NominationDeadlineOutcome
  nominationCount Int
  createdAt       DateTime                  @default(now()) @db.Timestamptz(3)
  session         Session                   @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@id([sessionId, deadlineVersion])
}

// Recipient intent only. Delivery is owned by the later notification phase.
model SessionProgressEvent {
  sessionId      String       @db.Uuid
  version        Int
  kind           String       @db.VarChar(20)
  phase          SessionPhase
  phaseVersion   Int
  detailsVersion Int
  acceptedCount  Int
  nominatedCount Int
  recipientIds   String[]     @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  session        Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, version])
}

model SessionRating {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId     String             @db.Uuid
  participantId String             @db.Uuid
  score         Int
  comment       String?
  submittedAt   DateTime?          @default(now()) @db.Timestamptz(3)
  session       Session            @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  participant   SessionParticipant @relation(fields: [participantId, sessionId], references: [id, sessionId], onDelete: Restrict)

  @@unique([participantId, sessionId])
  @@index([sessionId])
}

enum PersonalRatingSource {
  PERSONAL
  SESSION
}

model PersonalMovieRating {
  userId    String               @db.Uuid
  movieId   String               @db.Uuid
  score     Int
  source    PersonalRatingSource
  updatedAt DateTime             @default(now()) @updatedAt @db.Timestamptz(3)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie                @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
}

enum WatchlistPriority {
  LOW
  MEDIUM
  HIGH
}

model WatchlistItem {
  userId   String            @db.Uuid
  movieId  String            @db.Uuid
  priority WatchlistPriority
  addedAt  DateTime          @default(now()) @db.Timestamptz(3)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie    Movie             @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
}

enum NotificationEvent {
  SESSION_STARTED
  SELECTION_OPENED
  SELECTION_CLOSED
  RATING_OPENED
  RATING_CLOSED
  SESSION_CANCELLED
  NOMINATION_STALLED
  MEMBERSHIP_JOINED
  MEMBERSHIP_ROLE_CHANGED
  MEMBERSHIP_REMOVED
  MEMBERSHIP_LEFT
  CLUB_ARCHIVED
  CLUB_REACTIVATED
  ACHIEVEMENT_EARNED
  CLUB_INACTIVITY_WARNING
  BILLING_SERVICE
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  ACCEPTED
  DELIVERED
  FAILED
  SUPPRESSED
}

model Notification {
  id            String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId   String                        @db.Uuid
  event         NotificationEvent
  sourceId      String                        @db.Uuid
  occurrence    Int                           @default(1)
  clubId        String?                       @db.Uuid
  sessionId     String?                       @db.Uuid
  awardId       String?                       @db.Uuid
  inApp         Boolean
  email         Boolean
  readAt        DateTime?                     @db.Timestamptz(3)
  createdAt     DateTime                      @default(now()) @db.Timestamptz(3)
  recipient     User                          @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  attempts      NotificationDeliveryAttempt[]
  emailDelivery NotificationEmailDelivery?

  @@unique([recipientId, event, sourceId, occurrence])
  @@index([recipientId, inApp, createdAt, id])
}

model NotificationPreference {
  userId String            @db.Uuid
  event  NotificationEvent
  inApp  Boolean
  email  Boolean
  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, event])
}

model NotificationDeliveryAttempt {
  notificationId String                     @db.Uuid
  channel        NotificationChannel
  attempt        Int
  status         NotificationDeliveryStatus
  createdAt      DateTime                   @default(now()) @db.Timestamptz(3)
  completedAt    DateTime?                  @db.Timestamptz(3)
  notification   Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@id([notificationId, channel, attempt])
  @@index([channel, status, createdAt])
}

model NotificationEmailDelivery {
  notificationId   String                     @id @db.Uuid
  status           NotificationDeliveryStatus @default(PENDING)
  attemptCount     Int                        @default(0)
  nextAttemptAt    DateTime                   @default(now()) @db.Timestamptz(3)
  firstAttemptAt   DateTime?                  @db.Timestamptz(3)
  leaseUntil       DateTime?                  @db.Timestamptz(3)
  claimToken       String?                    @db.Uuid
  requestHash      String?
  recipientHash    String?
  providerId       String?                    @unique
  reason           String?
  alertAttemptedAt DateTime?                  @db.Timestamptz(3)
  alertSentAt      DateTime?                  @db.Timestamptz(3)
  notification     Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
}

model NotificationEmailSuppression {
  addressHash String   @id
  reason      String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
}

model NotificationEmailWebhook {
  id        String   @id
  type      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}
