generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum AppRole {
  USER
  APP_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  ANONYMIZED
}

enum ClubLifecycle {
  ACTIVE
  ARCHIVED
}

enum ClubRole {
  ADMIN
  MODERATOR
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  LEFT
  REMOVED
}

enum SessionType {
  FULL_CYCLE
  PRE_SELECTED
  PAST
}

enum SessionPhase {
  NOMINATION
  SELECTION
  WATCHING
  RATING
  COMPLETED
  CANCELLED
}

enum ContactDeliveryState {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

model User {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String            @unique
  emailVerified    Boolean           @default(false)
  displayName      String
  image            String?
  appRole          AppRole           @default(USER)
  status           UserStatus        @default(ACTIVE)
  locale           String            @default("en")
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  memberships      Membership[]
  authSessions     AuthSession[]
  providerAccounts ProviderAccount[]
}

model AuthSession {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ProviderAccount {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerSubject       String
  provider              String
  userId                String    @db.Uuid
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
}

model AuthVerification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String   @db.Text
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

model AuthRateLimit {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Club {
  id                String        @id @db.Uuid
  name              String
  description       String?
  lifecycle         ClubLifecycle @default(ACTIVE)
  selectionScaleMin Int           @default(1)
  selectionScaleMax Int           @default(5)
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  memberships       Membership[]
  sessions          Session[]
}

model Membership {
  id       String           @id @db.Uuid
  clubId   String           @db.Uuid
  userId   String           @db.Uuid
  role     ClubRole         @default(MEMBER)
  status   MembershipStatus @default(ACTIVE)
  joinedAt DateTime         @default(now()) @db.Timestamptz(3)
  leftAt   DateTime?        @db.Timestamptz(3)
  club     Club             @relation(fields: [clubId], references: [id], onDelete: Restrict)
  user     User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([clubId, userId])
  @@index([userId, status])
}

model Session {
  id           String       @id @db.Uuid
  clubId       String       @db.Uuid
  type         SessionType
  phase        SessionPhase
  scheduledAt  DateTime?    @db.Timestamptz(3)
  location     String?
  topic        String?
  notes        String?
  deadlineAt   DateTime?    @db.Timestamptz(3)
  phaseVersion Int          @default(1)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)
  club         Club         @relation(fields: [clubId], references: [id], onDelete: Restrict)

  @@index([clubId, phase])
}

model ContactMessage {
  id                   String               @id @db.Uuid
  submissionKey        String               @unique @db.Uuid
  sourceHash           String               @db.Char(64)
  contentHash          String               @db.Char(64)
  message              String?
  name                 String?
  email                String?
  deliveryState        ContactDeliveryState @default(PENDING)
  attemptCount         Int                  @default(0)
  nextAttemptAt        DateTime             @default(now()) @db.Timestamptz(3)
  processingLeaseUntil DateTime?            @db.Timestamptz(3)
  providerMessageId    String?              @unique
  deliveryErrorCode    String?
  deliveredAt          DateTime?            @db.Timestamptz(3)
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(3)

  @@index([sourceHash, createdAt])
  @@index([deliveryState, nextAttemptAt])
}
