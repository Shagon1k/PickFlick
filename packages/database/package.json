{
    "name": "@pickflick/database",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "pnpm generate && tsc -p tsconfig.build.json",
        "generate": "prisma generate --config prisma.config.ts",
        "migrate": "tsx src/cli/run-prisma.ts migrate deploy",
        "reset": "tsx src/cli/reset.ts",
        "seed": "tsx src/cli/run-prisma.ts db seed",
        "seed:release": "tsx src/cli/seed-release.ts",
        "services:check": "tsx src/cli/check-services.ts",
        "typecheck": "pnpm generate && tsc -p tsconfig.json"
    },
    "dependencies": {
        "@pickflick/config": "workspace:*",
        "@pickflick/observability": "workspace:*",
        "@prisma/adapter-pg": "7.10.0",
        "@prisma/client": "7.10.0",
        "pg": "8.23.0"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@types/pg": "8.23.1",
        "prisma": "7.10.0",
        "tsx": "catalog:",
        "typescript": "catalog:"
    }
}
