{
  "name": "@pickflick/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm generate && tsc -p tsconfig.build.json",
    "check": "tsx src/check-database.ts",
    "generate": "prisma generate --config prisma.config.ts",
    "migrate": "tsx src/run-prisma.ts migrate deploy",
    "reset": "tsx src/reset.ts",
    "seed": "tsx src/run-prisma.ts db seed",
    "services:check": "tsx src/check-services.ts",
    "typecheck": "pnpm generate && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@pickflick/config": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
