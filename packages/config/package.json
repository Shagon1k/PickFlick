{
    "name": "@pickflick/config",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        "./environment": {
            "types": "./src/environment.ts",
            "default": "./dist/environment.js"
        },
        "./eslint/base": "./eslint/base.mjs",
        "./tsconfig/base.json": "./tsconfig/base.json",
        "./tsconfig/library.json": "./tsconfig/library.json",
        "./tsconfig/nextjs.json": "./tsconfig/nextjs.json",
        "./tsconfig/node.json": "./tsconfig/node.json"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json && node scripts/validate.mjs",
        "typecheck": "tsc -p tsconfig.json && node scripts/validate.mjs"
    },
    "devDependencies": {
        "@eslint-react/eslint-plugin": "5.8.3",
        "@eslint/js": "10.0.1",
        "@next/eslint-plugin-next": "16.3.6",
        "@vitest/eslint-plugin": "1.6.27",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-jsx-a11y-x": "0.2.0",
        "eslint-plugin-playwright": "2.12.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-sonarjs": "4.2.1",
        "globals": "17.12.0",
        "typescript": "catalog:",
        "typescript-eslint": "8.69.0"
    },
    "peerDependencies": {
        "eslint": "10.10.0",
        "typescript": "6.0.3"
    },
    "peerDependenciesMeta": {
        "eslint": {
            "optional": true
        },
        "typescript": {
            "optional": true
        }
    },
    "dependencies": {
        "eslint-plugin-check-file": "3.3.2",
        "eslint-plugin-simple-import-sort": "14.0.0",
        "zod": "catalog:"
    }
}
