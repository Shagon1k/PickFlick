{
  "name": "@pickflick/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./environment": {
      "types": "./src/environment.ts",
      "default": "./dist/environment.js"
    },
    "./eslint/base": "./eslint/base.mjs",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/library.json": "./tsconfig/library.json",
    "./tsconfig/nextjs.json": "./tsconfig/nextjs.json",
    "./tsconfig/node.json": "./tsconfig/node.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/validate.mjs",
    "typecheck": "tsc -p tsconfig.json && node scripts/validate.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "globals": "17.12.0",
    "typescript": "catalog:",
    "typescript-eslint": "8.69.0"
  },
  "peerDependencies": {
    "eslint": "10.10.0",
    "typescript": "6.0.3"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
